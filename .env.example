# ==========================================
# SmartInterview Environment Variables
# ==========================================

# Core Application Settings
# -------------------------
APP_NAME="SmartInterview"
ENVIRONMENT="development"  # Options: development, production
DEBUG=True                 # Set to False in production

# API Keys
# --------
# Groq API Key - Required for the main adaptive AI engine
# Get one at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Database Configuration
# ----------------------
# Local SQLite is used by default. 
# For production (PostgreSQL), uncomment and set the following:
# DATABASE_URL="postgresql://user:password@localhost/dbname"

# Security & Authentication
# -------------------------
# Secret key used for JWT encoding (must be a strong random string)
# Generate one using: openssl rand -hex 32
SECRET_KEY="your_secret_jwt_signing_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# RAG / Vector Database Settings
# ------------------------------
# Set this to change where ChromaDB stores its embeddings
CHROMA_DB_DIR="./chroma_db"

# Server Settings (FastAPI)
# -------------------------
HOST="0.0.0.0"
PORT=8000
