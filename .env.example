# ==============================================================================
# SmartInterview — Environment Variables Specification (.env.example)
# ==============================================================================

# ── Core Application Settings ────────────────────────────────────────────────
APP_NAME=SmartInterview
ENVIRONMENT=development        # Options: development, production, test
DEBUG=True                    # Set to False in production

# ── Database Configuration ───────────────────────────────────────────────────
# MySQL connection string (default for development):
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/smartinterview

# Optional Redis connection string for session / token caching:
REDIS_URL=redis://localhost:6379/0

# ── Security & Authentication ────────────────────────────────────────────────
# Secret key used for signing JWT access tokens (generate: openssl rand -hex 32)
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440   # 24 hours

# Legacy aliases supported for backwards compatibility:
# SECRET_KEY=your_secret_jwt_signing_key_here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI & LLM Providers ───────────────────────────────────────────────────────
# LLM Provider: "groq" (default) or "ollama" (local)
LLM_PROVIDER=groq

# Groq Cloud API:
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Local Ollama (used if LLM_PROVIDER=ollama or as emergency fallback):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── RAG / Vector Database Settings ───────────────────────────────────────────
# Relative or absolute directory for ChromaDB vector embeddings
CHROMA_DB_DIR=chroma_db

# ── RAG Retrieval Mode (Hybrid Graph RAG) ────────────────────────────────────
# Active retrieval engine for interview question generation & syllabus mode:
# Options:
#   dense    — ChromaDB dense vector retrieval only (baseline default)
#   keyword  — BM25 lexical keyword retrieval only
#   graph    — Knowledge Graph 2-hop prerequisite retrieval only
#   hybrid   — Dense + Keyword + Graph multi-channel fusion
RAG_MODE=dense

# ── Knowledge Graph Storage Backend ──────────────────────────────────────────
# Storage engine for the concept graph:
# Options:
#   auto      — Attempts Neo4j connection; automatically falls back to in-memory NetworkX
#   networkx  — Pure in-memory NetworkX graph (zero external database required)
#   neo4j     — Strict Neo4j connection
GRAPH_STORAGE_BACKEND=auto

# Neo4j Database Credentials (only needed if GRAPH_STORAGE_BACKEND=neo4j or auto with live Neo4j):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ── Hybrid Retrieval Fusion Settings ─────────────────────────────────────────
# Fusion algorithm: "weighted" (score-based linear combination) or "rrf" (Reciprocal Rank Fusion)
HYBRID_FUSION_METHOD=weighted

# Weights for multi-channel linear combination (must sum to approximately 1.0):
HYBRID_VECTOR_WEIGHT=0.40
HYBRID_KEYWORD_WEIGHT=0.25
HYBRID_GRAPH_WEIGHT=0.35

# Reciprocal Rank Fusion constant:
HYBRID_RRF_K=60

# Candidate fetch limit per retrieval leg before fusion:
HYBRID_FETCH_K=10

# ── Contextual Reranking Settings ────────────────────────────────────────────
# Enable or disable reranking of non-dense candidate chunks before prompt construction:
RERANKER_ENABLED=true

# Reranker backend:
# Options:
#   semantic      — Direct cosine similarity using all-MiniLM-L6-v2 + lexical overlap boost (fast, 0 download)
#   cross_encoder — Joint cross-attention scoring via sentence_transformers.CrossEncoder
#   passthrough   — No-op slicing preserving original ranking order
RERANKER_BACKEND=semantic

# Cross-Encoder model name (only used if RERANKER_BACKEND=cross_encoder):
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Minimum relevance score threshold (0.0 to 1.0):
RERANKER_MIN_SCORE=0.0

# Final top-k candidate chunks passed to prompt construction after reranking:
RERANKER_TOP_K=3

# ── Server Settings (FastAPI) ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
